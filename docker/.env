# Copy to .env and edit:  cp .env.example .env
# Compose loads docker/.env automatically when you run from this directory.

# --- Required ---
# Your FoxESS device IP on the LAN (the one value you must set).
FOX_HOST=192.168.1.38

# --- Optional: REST API ---
# Comma-separated CORS origins. Use * for local/dev; set real origins in production.
FOX_CORS_ORIGINS=*

# --- Optional: host port mappings ---
# Host-side ports only; container-internal ports stay fixed (API 8080, etc.).
# Change these if another service already owns the default.
API_PORT=8090
MQTT_PORT=1883                 # mosquitto (profiles: mqtt, full)
PROMETHEUS_PORT=9090           # prometheus (profiles: metrics, full)
GRAFANA_PORT=3000              # grafana (profiles: metrics, full)

# --- Optional: Grafana (profiles: metrics, full) ---
# Change this before exposing Grafana beyond localhost.
GRAFANA_PASSWORD=admin
